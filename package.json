{
  "name": "hhousing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "pnpm -C apps/web-manager lint",
    "typecheck": "pnpm -C apps/web-manager typecheck",
    "test": "pnpm -C apps/web-manager test",
    "build": "pnpm -C apps/web-manager build",
    "desktop:dev": "pnpm -C apps/desktop dev",
    "desktop:start": "pnpm -C apps/web-manager build && pnpm -C apps/desktop start",
    "mobile:dev": "pnpm -C apps/mobile-tenant dev",
    "android": "pnpm -C apps/mobile-tenant android",
    "ios": "pnpm -C apps/mobile-tenant ios",
    "seed:demo": "node apps/web-manager/scripts/seed-demo-data.mjs",
    "seed:demo:wipe": "node apps/web-manager/scripts/seed-demo-data.mjs --wipe-seed-data",
    "seed:demo:refresh": "node apps/web-manager/scripts/seed-demo-data.mjs --wipe-seed-data --seed"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.14",
      "react": "19.0.0",
      "react-dom": "19.0.0"
    }
  }
}
