{
  "expo": {
    "name": "Mon Espace",
    "slug": "hhousing-mobile-tenant",
    "scheme": "hhousing-tenant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hhousing.tenant",
      "buildNumber": "2",
      "associatedDomains": [
        "applinks:harakaproperty.com",
        "applinks:www.harakaproperty.com"
      ]
    },
    "android": {
      "package": "com.hhousing.tenant",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "harakaproperty.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.harakaproperty.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "./plugins/with-keyboard-adjust-nothing.js",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Mon Espace to use Face ID to unlock the app and sign in."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0B1220"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32347c53-7cce-49c0-bd8a-f398aca141d3"
      }
    },
    "owner": "marcim"
  }
}
