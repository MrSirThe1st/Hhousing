# web-manager environment variables (copy to .env.local or Vercel)

# Public site URL (use https://www.harakaproperty.com in production)
NEXT_PUBLIC_APP_URL=https://www.harakaproperty.com
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=contact@harakaproperty.com
NEXT_PUBLIC_SUPPORT_EMAIL=tickets@haraka.p.tawk.email
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@harakaproperty.com

# PostHog (public browser analytics configuration)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TENANT_INVITATION_TEMPLATE=tenant_invitation_v1
WHATSAPP_TENANT_INVITATION_TEMPLATE_LANGUAGE=fr
WHATSAPP_LEASE_DOCUMENTS_TEMPLATE=lease_documents_v1
WHATSAPP_LEASE_DOCUMENTS_TEMPLATE_LANGUAGE=fr
WHATSAPP_PAYMENT_CONFIRMATION_TEMPLATE=payment_confirmation_v1
WHATSAPP_PAYMENT_CONFIRMATION_TEMPLATE_LANGUAGE=fr
WHATSAPP_LOGIN_OTP_TEMPLATE=tenant_login_otp_v1
WHATSAPP_LOGIN_OTP_TEMPLATE_LANGUAGE=fr
NOTIFICATION_DEFAULT_CHANNELS=email,whatsapp
TENANT_APP_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=com.hhousing.tenant
# Web password activation page (default: ${NEXT_PUBLIC_APP_URL}/invite)
MOBILE_TENANT_INVITE_URL_BASE=https://www.harakaproperty.com/invite

# PawaPay mobile money (server-side only)
PAWAPAY_API_TOKEN=
PAWAPAY_TOKEN_ID=
PAWAPAY_API_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_ENV=sandbox
PAWAPAY_DEFAULT_COUNTRY=COD

# SaaS landlord billing — PawaPay online checkout (UI flag; checkout not wired yet)
PAWAPAY_SAAS_ENABLED=false
NEXT_PUBLIC_PAWAPAY_SAAS_ENABLED=false

# SaaS landlord billing — offline Mobile Money fallback numbers
SAAS_BILLING_ORANGE_MONEY_NUMBER=
SAAS_BILLING_ORANGE_MONEY_NAME=
SAAS_BILLING_AIRTEL_MONEY_NUMBER=
SAAS_BILLING_AIRTEL_MONEY_NAME=
SAAS_BILLING_MPESA_NUMBER=
SAAS_BILLING_MPESA_NAME=
SAAS_BILLING_PAYMENT_INSTRUCTIONS=

# PostHog (https://eu.posthog.com/settings/project — use eu.i.posthog.com for EU projects)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Tawk.to chat (public + operator surfaces; hidden on /admin)
# Defaults match the Haraka Property property if unset
NEXT_PUBLIC_TAWK_PROPERTY_ID=6a732b3e2502921d483ec339
NEXT_PUBLIC_TAWK_WIDGET_ID=1jvgcml3v
